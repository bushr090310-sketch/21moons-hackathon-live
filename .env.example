# --- Required ---------------------------------------------------------------
# Shared organizer password for /admin
ADMIN_PASSWORD=
# 32+ random chars. Signs session cookies and keys voting-code hashes.
# Do NOT change during the event (it would invalidate voting codes).
SESSION_SECRET=

# Postgres (Supabase). The Vercel <> Supabase integration sets POSTGRES_URL /
# POSTGRES_URL_NON_POOLING automatically; DATABASE_URL works too.
DATABASE_URL=

# --- Supabase (Storage for evidence + Realtime) -----------------------------
# Server-only (NEVER expose to the browser):
SUPABASE_SERVICE_ROLE_KEY=
# Public (safe for the browser; used only for the data-free realtime signal):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- CRM (Supabase Auth) ------------------------------------------------------
# The CRM uses NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY above (RLS enforces access)
# and SUPABASE_SERVICE_ROLE_KEY only in /api/account/delete (GDPR self-delete).
# Optional: show OAuth buttons once the provider is enabled in Supabase Auth.
AUTH_PROVIDERS=            # e.g. github,linkedin_oidc
